# 必须通过 HTTPS 访问；Keycloak 回调为此地址 + /auth/callback
PLATFORM_ORIGIN=https://platform.lazycampus.com
LISTEN_ADDR=:3000
OIDC_ISSUER=https://auth.lazycampus.com/realms/lazycampus
OIDC_CLIENT_ID=lazycampus-platform
OIDC_CLIENT_SECRET=

# 生产使用独立 MySQL 账号，不使用 root。
MYSQL_HOST=mysql.mysql-system.svc.cluster.local
MYSQL_PORT=3306
MYSQL_DATABASE=lazycampus_platform
MYSQL_USER=lazycampus_platform
MYSQL_PASSWORD=
# 可选：使用 DATABASE_DSN（MySQL DSN）覆盖以上配置。

REDIS_URL=redis://redis:6379/0
CAMPUS_SERVICE_URL=http://api.easy-swu.svc.cluster.local:3000
# 至少 32 字符，与 Easy SWU 的 OPEN_PLATFORM_SERVICE_SECRET 一致。
CAMPUS_SERVICE_SECRET=
# Sender 事务邮件；不配置时仅提供站内通知。
# 密钥只进入服务器 Secret，不进入仓库或前端。
SENDER_API_KEY=
SENDER_FROM_EMAIL=
SENDER_FROM_NAME=Lazy Campus
# APP_REVISION 由构建提交 SHA 自动设置；不要手工填写版本文件。
